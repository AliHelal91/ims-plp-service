<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">
    

    <!-- 1 Enable UUID extension -->
    <changeSet id="001-enable-uuid-extension" author="Ali Hilal" dbms="postgresql">
        <sql>
            CREATE EXTENSION IF NOT EXISTS "uuid-ossp";
        </sql>
    </changeSet>

    <!-- 2 Create audit_change_log table -->
    <changeSet id="002-create-audit-change-log" author="Ali Hilal">
        <createTable tableName="audit_change_log" schemaName="ims_plp_service_db">

            <column name="id" type="UUID" defaultValueComputed="uuid_generate_v4()">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="entity_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="entity_id" type="UUID">
                <constraints nullable="false"/>
            </column>

            <column name="action" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="change_reason" type="TEXT">
                <constraints nullable="false"/>
            </column>

            <column name="changed_fields" type="JSONB"/>
            <column name="before_state" type="JSONB">
                <constraints nullable="false"/>
            </column>

            <column name="after_status" type="JSONB">
                <constraints nullable="false"/>
            </column>

            <column name="sync_batch_id" type="UUID">
                <constraints nullable="false"/>
            </column>

            <column name="request_id" type="UUID"/>

            <column name="source_system" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>

            <column name="triggered_by" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>

            <column name="error_type" type="VARCHAR(50)"/>
            <column name="error_code" type="VARCHAR(50)"/>
            <column name="error_message" type="TEXT"/>

            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <!-- Foreign key to request table -->
        <addForeignKeyConstraint baseTableName="audit_change_log"
                                 baseColumnNames="request_id"
                                 referencedTableName="request"
                                 referencedColumnNames="id"
                                 baseTableSchemaName="ims_plp_service_db"
                                 referencedTableSchemaName="ims_plp_service_db"
                                 constraintName="fk_audit_request"/>
    </changeSet>

    <!-- 3 Add indexes -->
    <changeSet id="003-add-audit-change-log-indexes" author="Ali Hilal">

        <!-- Entity lookup -->
        <createIndex indexName="idx_audit_entity" tableName="audit_change_log" schemaName="ims_plp_service_db">
            <column name="entity_type"/>
            <column name="entity_id"/>
        </createIndex>

        <!-- Sync batch index -->
        <createIndex indexName="idx_audit_sync_batch" tableName="audit_change_log" schemaName="ims_plp_service_db">
            <column name="sync_batch_id"/>
        </createIndex>

        <!-- Request index -->
        <createIndex indexName="idx_audit_request_id" tableName="audit_change_log" schemaName="ims_plp_service_db">
            <column name="request_id"/>
        </createIndex>

        <!-- JSONB GIN index for changed_fields -->
        <sql>
            CREATE INDEX IF NOT EXISTS idx_audit_changed_fields_gin
            ON ims_plp_service_db.audit_change_log
            USING GIN (changed_fields);
        </sql>

        <!-- JSONB GIN index for before_state -->
        <sql>
            CREATE INDEX IF NOT EXISTS idx_audit_before_state_gin
            ON ims_plp_service_db.audit_change_log
            USING GIN (before_state);
        </sql>

        <!-- JSONB GIN index for after_status -->
        <sql>
            CREATE INDEX IF NOT EXISTS idx_audit_after_status_gin
            ON ims_plp_service_db.audit_change_log
            USING GIN (after_status);
        </sql>

    </changeSet>

</databaseChangeLog>
