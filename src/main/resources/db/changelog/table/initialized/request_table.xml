<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">
    

    <!-- 1 Enable UUID extension -->
    <changeSet id="002-enable-uuid-extension" author="Ali Hilal" dbms="postgresql">
        <sql>
            CREATE EXTENSION IF NOT EXISTS "uuid-ossp";
        </sql>
    </changeSet>

    <!-- 2 Create request table -->
    <changeSet id="003-create-request-table" author="Ali Hilal">
        <createTable tableName="request" schemaName="ims_plp_service_db">

            <column name="id" type="UUID" defaultValueComputed="uuid_generate_v4()">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="sync_batch_id" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>

            <column name="request_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="request_payload" type="JSONB">
                <constraints nullable="false"/>
            </column>
            <column name="response_payload" type="JSONB"/>

            <column name="parent_history_id" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>

            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="error_type" type="VARCHAR(50)"/>
            <column name="error_code" type="VARCHAR(50)"/>
            <column name="error_message" type="TEXT"/>

            <column name="retry_count" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <column name="max_retries" type="INTEGER" defaultValueNumeric="3">
                <constraints nullable="false"/>
            </column>

            <column name="next_retry_at" type="INTEGER"/>

            <column name="started_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="completed_at" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

        </createTable>
    </changeSet>

    <!-- 3 Add indexes -->
    <changeSet id="004-add-request-indexes" author="Ali Hilal">

        <!-- Index for batch processing -->
        <createIndex indexName="idx_request_sync_batch" tableName="request" schemaName="ims_plp_service_db">
            <column name="sync_batch_id"/>
        </createIndex>

        <!-- Index for status lookup -->
        <createIndex indexName="idx_request_status" tableName="request" schemaName="ims_plp_service_db">
            <column name="status"/>
        </createIndex>

        <!-- Index for retry scheduling -->
        <createIndex indexName="idx_request_retry" tableName="request" schemaName="ims_plp_service_db">
            <column name="retry_count"/>
            <column name="next_retry_at"/>
        </createIndex>

        <!-- Index for parent history grouping -->
        <createIndex indexName="idx_request_parent_history" tableName="request" schemaName="ims_plp_service_db">
            <column name="parent_history_id"/>
        </createIndex>

        <!-- JSONB GIN index for request_payload -->
        <sql>
            CREATE INDEX IF NOT EXISTS idx_request_payload_gin
            ON ims_plp_service_db.request
            USING GIN (request_payload);
        </sql>

        <!-- JSONB GIN index for response_payload -->
        <sql>
            CREATE INDEX IF NOT EXISTS idx_response_payload_gin
            ON ims_plp_service_db.request
            USING GIN (response_payload);
        </sql>

    </changeSet>

</databaseChangeLog>
