<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- 1 Create Sequence -->
    <changeSet id="lookup-value-001-create-sequence" author="Ali Hilal">
        <createSequence
                schemaName="ims_plp_service_db"
                sequenceName="lookup_value_seq"
                startValue="1"
                incrementBy="1"/>
    </changeSet>

    <!--  2 Create Table -->
    <changeSet id="lookup-value-002-create-table" author="Ali Hilal">
        <createTable tableName="lookup_value" schemaName="ims_plp_service_db">

            <column name="id" type="BIGINT">
                <constraints primaryKey="true"
                             nullable="false"
                             primaryKeyName="pk_lookup_value"/>
            </column>

            <column name="value" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>

            <column name="display_en" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="display_ar" type="VARCHAR(255)"/>

            <column name="is_active" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="lookup_category_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

        </createTable>
    </changeSet>

    <!-- 3 Foreign Key -->
    <changeSet id="lookup-value-003-add-fk" author="Ali Hilal">
        <addForeignKeyConstraint
                baseTableSchemaName="ims_plp_service_db"
                baseTableName="lookup_value"
                baseColumnNames="lookup_category_id"
                referencedTableSchemaName="ims_plp_service_db"
                referencedTableName="lookup_category"
                referencedColumnNames="id"
                constraintName="fk_lookup_value_category"
                onDelete="CASCADE"/>
    </changeSet>

    <!-- 4 Indexes -->
    <changeSet id="lookup-value-004-indexes" author="Ali Hilal">

        <createIndex indexName="idx_lookup_value_category"
                     schemaName="ims_plp_service_db"
                     tableName="lookup_value">
            <column name="lookup_category_id"/>
        </createIndex>

        <createIndex indexName="idx_lookup_value_is_active"
                     schemaName="ims_plp_service_db"
                     tableName="lookup_value">
            <column name="is_active"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
